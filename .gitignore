# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/

# Project-specific exclusions (keep local media and brand assets out of git)
# Note: patterns must be on their own lines — inline # is not a comment in gitignore.
transcripts/
source_video/
logos/

# Streamlit secrets (API keys, credentials)
.streamlit/secrets.toml

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Output files (optional - comment out if you want to track outputs)
*_portrait_stacked.mp4
*_clip*.mp4
*_preview.mp4
*_layout_preview.jpg
output/

# Log files
*.log
clip_generation*.log

# Video files
stacked_script/videos

# HyperFrames installs dependencies locally for isolated compositions
long_form/hyperframes/**/node_modules/
long_form/hyperframes/**/.hf-frames/

# Temporary test and generation scripts
test_*.py
generate_clip*.py
regenerate_*.py
